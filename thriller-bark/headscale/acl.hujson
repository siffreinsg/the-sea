	},
	"acls": [
		{
			"action": "accept",
			"src": ["tag:tb"],
			"dst": [
				"tag:gm:8428",   // VictoriaMetrics remote_write
				"tag:gm:3100",   // Loki push
				"tag:gm:4317",   // Tempo OTLP gRPC
				"tag:gm:3200",   // Dawarich
				"tag:gm:9898",   // Backrest-GM
				"tag:gm:3000",   // Grafana
				"tag:gm:6868",   // Profilarr
				"tag:gm:11011",  // Cleanuparr
				"tag:gm:8095",   // your_spotify
				"tag:gm:3002",   // Playwright
				"tag:gm:3050",   // Karakeep
				"tag:gm:8123",   // Home Assistant
			],
		},
		{
			"action": "accept",
			"src": ["tag:gm"],
			"dst": ["tag:tb:22000"],   // Syncthing BEP, mesh-capable peer skipping the public path
		},
		{
			"action": "accept",
			"src": ["tag:baratie"],
			"dst": [
				"tag:gm:8428",   // VictoriaMetrics remote_write
				"tag:gm:3100",   // Loki push
				"tag:gm:4317",   // Tempo OTLP gRPC
			],
		},
		{
			"action": "accept",
			"src": ["tag:gm"],
			"dst": ["192.168.1.0/24:*"],   // HA reaching Yeelight/Bravia behind Baratie's subnet route
		},
	],
