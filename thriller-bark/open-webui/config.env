# Open-WebUI, non-secret config. Secrets are in secrets.env (sops) -> .env, loaded after
# this file so it wins on conflicts. Upstream defaults are deliberately NOT written here;
# every line below is a change from v0.10.2's default. Commented lines are settings worth
# reaching for when something breaks, kept next to what they relate to.
#
# ENABLE_PERSISTENT_CONFIG=False makes this file the single source of truth: the Admin UI
# still lets you edit most of these and silently discards the change on restart. Edit here.
ENABLE_PERSISTENT_CONFIG=False

# --- identity -----------------------------------------------------------------------
# Built into the OAuth redirect URI via request.url_for(); without it Open-WebUI derives
# http:// behind Caddy. Same failure as the Dawarich bug.
WEBUI_URL=https://chat.siffreinsigy.me

# --- gateway ------------------------------------------------------------------------
# LiteLLM by container name over the-sea-internal. Not 127.0.0.1 — that is the container's
# own loopback, not the host's. Service DNS also survives a network recreate, which a
# gateway IP does not.
OPENAI_API_BASE_URL=http://litellm:4000/v1
# Sends X-OpenWebUI-User-{Name,Id,Email,Role} to LiteLLM, so spend and traces attribute to
# a person rather than to one shared virtual key. Safe here because the hop is a private
# network to our own gateway — this would be leaking PII to any third-party endpoint.
# FORWARD_USER_INFO_HEADER_JWT_SECRET would sign them into one JWT instead; not needed
# while LiteLLM is the only consumer and cannot be reached by anything else.
ENABLE_FORWARD_USER_INFO_HEADERS=True
# Groups every call in one chat under one session in LiteLLM. Open-WebUI sends the chat id
# already, but its default header name is X-OpenWebUI-Chat-Id, and LiteLLM only recognises
# `x-<vendor>-session-id` (litellm_pre_call_utils.py:43). Renaming it here is the entire
# fix — no LiteLLM-side config, and the value is a UUID, which clears LiteLLM's
# "8+ chars, alphanumeric" validation.
# Only sent when ENABLE_FORWARD_USER_INFO_HEADERS is True; the two are coupled upstream.
FORWARD_SESSION_INFO_HEADER_CHAT_ID=X-OpenWebUI-Session-Id
# OPENAI_API_KEY -> secrets.env (a LiteLLM virtual key, never the master key)

# TB is ARM and CPU-only; there is no Ollama to talk to. Default True makes every
# model-list call poll localhost:11434 and fail noisily.
ENABLE_OLLAMA_API=False

# --- database -------------------------------------------------------------------------
# Postgres, not SQLite. Same instance as LiteLLM, own database and role, still no
# published port — every consumer is on the-sea-internal.
# Chosen over splitting the vector store onto GM's fast disk: a single-user corpus fits
# TB's page cache, so GM's 40x IOPS buys nothing, while splitting would mean a second
# Postgres, a mesh-published port, and document chunks in the clear on a
# provider-controlled kernel.
# Break-glass is now psql rather than hand-editing SQLite in the container.
# DATABASE_URL -> secrets.env (it carries the password)
#
# Unset, DATABASE_POOL_SIZE selects NullPool (internal/db.py:278) — a brand new Postgres
# connection for every request. Harmless on SQLite, wrong here: each connection is a
# forked backend process, and this Postgres also serves LiteLLM.
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=5
# DATABASE_ENABLE_SQLITE_WAL is moot now and deliberately absent.

# --- vector store ---------------------------------------------------------------------
# Defaults to `chroma` (config.py:493) — pgvector is not implicit just because Postgres is
# the primary DB. PGVECTOR_DB_URL is left unset: it inherits DATABASE_URL (config.py:638).
VECTOR_DB=pgvector
# Must match the embedding model's fixed 3584 dimensions, and must be right **before the
# first document is indexed** — changing it later means dropping the index and re-embedding
# the whole corpus at Scaleway's per-token rate.
PGVECTOR_INITIALIZE_MAX_VECTOR_LENGTH=3584
# Not optional at 3584: config.py:647 raises ValueError above 2000, pgvector's index limit
# for the `vector` type. It also selects an hnsw index instead of ivfflat
# (pgvector.py:187), so this is the better path regardless.
PGVECTOR_USE_HALFVEC=True
# PGVECTOR_PGCRYPTO stays off: the key would live in the same .env on the same host, the
# query path pays CPU to decrypt (pgvector.py:441-700), and the conversation archive in
# LiteLLM_SpendLogs is plaintext anyway — it would protect the derivative, not the original.

# --- auth: SSO only, no local password path -----------------------------------------
OPENID_PROVIDER_URL=https://auth.siffreinsigy.me/.well-known/openid-configuration
OAUTH_PROVIDER_NAME=Authelia
OAUTH_CODE_CHALLENGE_METHOD=S256
# Defaults to *. Must match the domain of the email on the Authelia user — a mismatch
# refuses login *after* a successful Authelia auth, which reads as a broken client.
OAUTH_ALLOWED_DOMAINS=siffreinsigy.me
OAUTH_AUTO_REDIRECT=True
# ENABLE_LOGIN_FORM only hides the form; /signin still accepts a POSTed password.
# ENABLE_PASSWORD_AUTH is the actual backend gate.
ENABLE_PASSWORD_AUTH=False
ENABLE_LOGIN_FORM=False
ENABLE_SIGNUP=False
ENABLE_PASSWORD_CHANGE_FORM=False
# First boot only: flip to True, log in once via Authelia, flip back and redeploy.
# The first user is promoted to admin after insert (utils/oauth.py:1923), so
# DEFAULT_USER_ROLE=pending does not lock you out.
# **Required again on the Postgres cutover** — the fresh database has no users.
ENABLE_OAUTH_SIGNUP=False
# Accepted risk: Authelia is the only door. WEBUI_ADMIN_EMAIL/_PASSWORD break-glass is
# mutually exclusive with ENABLE_PASSWORD_AUTH=False and was rejected.

# Defaults to 4w, and Open-WebUI has no token revocation list — a stolen token would stay
# valid for a month. Short app sessions are cheap precisely because Authelia holds the long
# one: with OAUTH_AUTO_REDIRECT the renewal is an invisible bounce.
JWT_EXPIRES_IN=24h

# ENABLE_ADMIN_CHAT_ACCESS and ENABLE_ADMIN_EXPORT both default True and are left there on
# purpose: sole admin and sole user, and both are needed to support test or external
# accounts. **This is not a company-shippable posture** — it is already off on the company
# infrastructure — so do not copy these two defaults outward.

# --- cookies ------------------------------------------------------------------------
# Both default False despite this app being HTTPS-only behind Caddy.
# SameSite stays lax: strict breaks the OIDC callback.
WEBUI_SESSION_COOKIE_SECURE=True
WEBUI_AUTH_COOKIE_SECURE=True

# Defaults to *, which the app warns about at every boot (config.py:2086).
CORS_ALLOW_ORIGIN=https://chat.siffreinsigy.me

# --- API keys: off, deliberately ----------------------------------------------------
# Both switches default False, so nothing is written. Guarded because this app gets OIDC:
# Caddy is a plain reverse_proxy with no forward_auth, so turning API keys on exposes
# /api/* to the public internet behind nothing but a bearer token, and an unscoped key
# can read every chat and change admin settings. If you ever want it, all five lines:
# ENABLE_API_KEYS=True
# USER_PERMISSIONS_FEATURES_API_KEYS=True
# ENABLE_API_KEYS_ENDPOINT_RESTRICTIONS=True
# API_KEYS_ALLOWED_ENDPOINTS=/api/chat/completions,/api/models
# (CORS_ALLOW_ORIGIN is already pinned above.)

# --- code execution: off until the terminal decision lands ---------------------------
# Both default **True** (config.py:399,414), so silence here means enabled. The engine
# defaults to Pyodide in the browser rather than a Jupyter backend, so the blast radius is
# the user's tab rather than TB — but it is on, and that is not a decision anyone made.
# Revisit with Open Terminal / ContainerSSH.
ENABLE_CODE_EXECUTION=False
ENABLE_CODE_INTERPRETER=False

# --- cost control -------------------------------------------------------------------
# TASK_MODEL_EXTERNAL is empty by default (config.py:2125), which means these background
# features hit whatever model you are chatting with.
ENABLE_FOLLOW_UP_GENERATION=False
ENABLE_TAGS_GENERATION=False
# Title generation stays on (default True): once per chat, and without it the sidebar is
# truncated first messages.
#
# `task-cheap` is a LiteLLM model *group*, not a model: Mistral's free tier first, falling
# back to paid Scaleway when the free quota is exhausted. The indirection is what lets the
# free/paid split change in litellm/config.yaml without touching this file.
# **Only mechanical calls route there** — in practice title generation and retrieval query
# generation, since tags and follow-ups are off above. Free tiers train on what you send
# them, and title generation still sees the user's first message, so this is a bounded
# trade rather than zero exposure. Main chat never touches a free tier.
TASK_MODEL_EXTERNAL=task-cheap

# --- speech to text -----------------------------------------------------------------
# AUDIO_STT_ENGINE defaults to empty, which means *local faster-whisper*: a model download
# and CPU inference on TB's ARM box on the first transcription. Same trap as the local
# embedding model below. Point it at LiteLLM instead; AUDIO_STT_OPENAI_API_BASE_URL and
# _KEY both fall back to the OPENAI_* values above (config.py:1531,1533), so nothing else
# is needed.
AUDIO_STT_ENGINE=openai
AUDIO_STT_MODEL=scw-whisper-large-v3
# Text-to-speech is off by constraint, not preference: Scaleway exposes no
# /v1/audio/speech model, and no second paid vendor is being added.

# --- embeddings ---------------------------------------------------------------------
# main.py:587 calls get_ef() in the startup path unconditionally, so with the engine unset
# the app loads sentence-transformers/all-MiniLM-L6-v2 and holds it in RAM on TB's ARM CPU
# whether or not RAG is used — that is the BertModel LOAD REPORT in the boot log.
# Pointing the engine at LiteLLM removes it entirely. RAG_OPENAI_API_BASE_URL and
# RAG_OPENAI_API_KEY inherit the OPENAI_* values above (config.py:1073).
#
# Note the -slim image does NOT omit the ML stack: USE_SLIM=true only skips *downloading
# model weights* (Dockerfile:156, workflow docker.yaml:54). torch and sentence-transformers
# are installed either way, so a local engine would download at runtime rather than fail
# cleanly. requirements-min.txt exists in the repo but no image uses it.
RAG_EMBEDDING_ENGINE=openai
# Fixed 3584 dimensions — see PGVECTOR_INITIALIZE_MAX_VECTOR_LENGTH above, which must match.
RAG_EMBEDDING_MODEL=scw-bge-multilingual-gemma2
# Default is True: executes arbitrary Python from a HuggingFace repo at model load.
RAG_EMBEDDING_MODEL_TRUST_REMOTE_CODE=False
# Both remove a HuggingFace fetch from the boot path. These only bite if the engine is ever
# switched back to a local model; kept as a guard rather than removed.
RAG_EMBEDDING_MODEL_AUTO_UPDATE=False
RAG_RERANKING_MODEL_AUTO_UPDATE=False
# Rejected: OFFLINE_MODE=True (also kills the version check) and
# BYPASS_EMBEDDING_AND_RETRIEVAL=True (ConfigVar, subtle).

# --- document extraction --------------------------------------------------------------
# Default is in-process pypdf/docx2txt, which works but is the quality bottleneck and
# competes with the web server for CPU. Tika is a separate, independently scalable tier —
# the shape a company deployment wants — and apache/tika:3.3.1.0-full publishes arm64, so
# it runs on TB next to the uploader.
CONTENT_EXTRACTION_ENGINE=tika
TIKA_SERVER_URL=http://tika:9998

# --- chunking ---------------------------------------------------------------------------
# Careful: CHUNK_SIZE changes unit with the splitter. Default (character) means 1000
# characters; `token` means 1000 tokens, ~4x larger from an unchanged line.
# Tokens are the unit the embedding model and the context window both actually measure,
# which is what keeps top-k budgeting predictable across French and English documents.
#
# cl100k is OpenAI's tokenizer, not bge's, so this is a good proxy rather than exact. And
# on -slim the encoding is not baked in: tiktoken.get_encoding() (retrieval.py:1685)
# fetches at the first ingest and then caches inside the volume. An air-gapped deployment
# has to pre-seed it.
#
# **Worth benchmarking against a real corpus** — see docs/future.md.
RAG_TEXT_SPLITTER=token
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# Splits markdown on header boundaries first, so only oversized sections get token-split.
# Does nothing for the PDF/Office content Tika returns as plain text.
ENABLE_MARKDOWN_HEADER_TEXT_SPLITTER=True

# --- retrieval --------------------------------------------------------------------------
# pgvector implements hybrid_search natively (pgvector.py:538), so BM25 and vector fusion
# happen in the database rather than in Python.
ENABLE_RAG_HYBRID_SEARCH=True
# With no reranker, TOP_K is what reaches the prompt directly — there is no second stage
# to narrow it. It was 40 only because a cross-encoder cut it to 8; left at 40 it would
# stuff every candidate into context ([why no reranker](../../docs/ADR/2026-07-28-no-reranking.md)).
RAG_TOP_K=8
# RAG_RELEVANCE_THRESHOLD and RAG_HYBRID_BM25_WEIGHT stay at 0.0 / 0.5: relevance scores
# are not comparable across models, so a threshold set before seeing real distributions
# silently drops good chunks.

# --- reranking --------------------------------------------------------------------------
# None. RAG_RERANKING_ENGINE stays unset, which is Open-WebUI's default and means hybrid
# search returns its own fused ranking. A CPU cross-encoder was measured and is far too
# slow on this hardware ([why](../../docs/ADR/2026-07-28-no-reranking.md)).

# --- upload limits ----------------------------------------------------------------------
# All three default to unlimited: MAX_SIZE and MAX_COUNT are None (config.py:958-960) and
# ALLOWED_FILE_EXTENSIONS is an empty list, meaning every extension. Uncapped uploads feed
# TB's scarcest resource and a per-token embedding bill with nothing in the way.
# The allow-list also keeps Tika from being handed formats you never intended — document
# parsers are a classic exploit target.
RAG_FILE_MAX_SIZE=25
RAG_FILE_MAX_COUNT=10
RAG_ALLOWED_FILE_EXTENSIONS=pdf,docx,pptx,xlsx,txt,md,csv
# ENABLE_RETRIEVAL_UNSCOPED_COLLECTIONS, BYPASS_EMBEDDING_AND_RETRIEVAL, RAG_FULL_CONTEXT
# and ENABLE_RAG_LOCAL_WEB_FETCH all default False, which is already the safe value.

# --- web search -------------------------------------------------------------------------
# SearXNG on GM, not TB: it aggregates upstream engines by scraping them, and that
# reputation belongs on the VPS rather than on the IP serving the public endpoints.
# SearXNG must have `json` in its settings.yml search.formats or Open-WebUI gets HTML back.
ENABLE_WEB_SEARCH=True
WEB_SEARCH_ENGINE=searxng
# No `?q=<query>` placeholder: searxng.py:32 treats that as the *legacy* form and strips
# the query string anyway. The bare /search URL is what the loader wants.
SEARXNG_QUERY_URL=http://100.64.0.1:8080/search
# 5 pages, still embedded and retrieved rather than dumped straight into context. Web
# content is noisy and TOP_K=8 is now the only filter, so keep this low.
WEB_SEARCH_RESULT_COUNT=5

# Firecrawl, self-hosted on GM: API + Redis + a Playwright service. It *is* Playwright
# underneath, plus markdown extraction, retries and caching — and unlike a bare Playwright
# container it exposes an HTTP API that n8n can call too, making it a fleet
# content-acquisition tier rather than an Open-WebUI accessory.
# Two things to know: self-hosting loses Fire-engine, so bot-detection handling is absent;
# and Open-WebUI v0.10.2 speaks the **v2** API (firecrawl.py:24-27), which must be verified
# against the self-hosted image.
# FIRECRAWL_API_KEY -> secrets.env (whatever the self-hosted instance is configured with).
WEB_LOADER_ENGINE=firecrawl
FIRECRAWL_API_BASE_URL=http://100.64.0.1:3002
# Defaults to `en` alone.
YOUTUBE_LOADER_LANGUAGE=fr,en

# --- misc ---------------------------------------------------------------------------
# langchain warns at every boot when this is unset.
USER_AGENT=open-webui/0.10.2 (+https://chat.siffreinsigy.me)

# --- logging ------------------------------------------------------------------------
# Audit logging stays off. AUDIT_LOG_LEVEL defaults to NONE (env.py:1087), so the previous
# ENABLE_AUDIT_STDOUT=True line produced nothing at all — it has been removed rather than
# left implying a feature that does not run. To turn it on, set AUDIT_LOG_LEVEL=METADATA
# and add ENABLE_AUDIT_STDOUT=True back; AUDIT_EXCLUDED_PATHS already defaults to
# /chats,/chat,/folders, which keeps chat bodies out even at REQUEST_RESPONSE.
#
# This one still matters while the level is NONE: it defaults True (env.py:1072) and writes
# ${DATA_DIR}/audit.log with 10MB rotation — a growing file inside the volume that Backrest
# then backs up.
ENABLE_AUDIT_LOGS_FILE=False

# --- tracing --------------------------------------------------------------------------
# To Alloy on the host, which relays to Tempo on GM. ENABLE_OTEL is the master switch and
# each signal has its own: metrics and logs stay off, VictoriaMetrics and Loki cover those.
ENABLE_OTEL=True
ENABLE_OTEL_TRACES=True
# The exporter is gRPC by default (env.py:1139), so this is host:port with no path --
# unlike LiteLLM, which uses otlp_http and needs /v1/traces. Default is localhost:4317,
# which is the container's own loopback and would silently export nowhere.
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
# Defaults False (env.py:1120), i.e. the gRPC exporter demands TLS and fails without this.
# Plaintext is fine: the hop is container -> host on the same box.
OTEL_EXPORTER_OTLP_INSECURE=True
# Outbound calls to LiteLLM carry traceparent already -- aiohttp and httpx are both
# instrumented (utils/telemetry/instrumentors.py) -- so this lands as one tree, not two.

# --- phone-home / features off ------------------------------------------------------
ENABLE_COMMUNITY_SHARING=False
ENABLE_EVALUATION_ARENA_MODELS=False
# ENABLE_VERSION_UPDATE_CHECK stays at its True default: the upgrade nudge is worth it and
# is the only phone-home kept.
# ENABLE_PLUGINS and ENABLE_PIP_INSTALL_FRONTMATTER_REQUIREMENTS stay True on purpose, so
# community functions/pipelines remain installable. Accepted cost: a function's frontmatter
# can pip-install arbitrary packages into the container.
# ENABLE_MEMORIES, ENABLE_NOTES and ENABLE_MESSAGE_RATING stay at their True defaults;
# message rating deliberately, as the quality signal for comparing models.
# ENABLE_IMAGE_GENERATION defaults to False (config.py:1302) and stays off.
