// ---- outputs ----
prometheus.remote_write "vm" {
  endpoint {
    url = "http://100.64.0.1:8428/api/v1/write"
  }
}

loki.write "central" {
  endpoint {
    url = "http://100.64.0.1:3100/loki/api/v1/push"
  }
  external_labels = { node = "thriller-bark" }
}

// every metric gets node="thriller-bark" before leaving
prometheus.relabel "add_node" {
  forward_to = [prometheus.remote_write.vm.receiver]
  rule {
    target_label = "node"
    replacement  = "thriller-bark"
  }
}

// ---- host metrics (embedded node_exporter) ----
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
  // Picks up docker_volume_size_bytes from the hourly volume-sizes timer. cadvisor only
  // measures a container's writable layer, so without this the dashboards cannot see
  // where the disk actually went — every byte that matters is in a named volume.
  enable_collectors = ["textfile"]
  textfile {
    directory = "/host/root/var/lib/node_exporter/textfile"
  }
}
prometheus.scrape "host" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.relabel.add_node.receiver]
}

// ---- container metrics (embedded cadvisor) ----
prometheus.exporter.cadvisor "containers" {
  docker_host = "unix:///var/run/docker.sock"
}
prometheus.scrape "containers" {
  targets    = prometheus.exporter.cadvisor.containers.targets
  forward_to = [prometheus.relabel.add_node.receiver]
}

// ---- local endpoints ----
prometheus.scrape "headscale" {
  targets    = [{ __address__ = "127.0.0.1:9090", job = "headscale" }]
  forward_to = [prometheus.relabel.add_node.receiver]
}
prometheus.scrape "caddy" {
  targets    = [{ __address__ = "127.0.0.1:2020", job = "caddy" }]
  forward_to = [prometheus.relabel.add_node.receiver]
}
// LiteLLM's own /metrics: spend, tokens, latency and failures per model and virtual key.
// This is the exception to "container resource usage is already covered" — none of it
// exists anywhere else, and the traces carry individual calls but nothing aggregated.
prometheus.scrape "litellm" {
  targets    = [{ __address__ = "127.0.0.1:4000", job = "litellm" }]
  forward_to = [prometheus.relabel.add_node.receiver]
}

// ---- traces ----
// Apps ship OTLP here, Alloy relays to Tempo on GM. They cannot push to Tempo directly:
// the mesh guard DROPs 172.16/12 -> 100.64/10 in raw/PREROUTING, by design. Alloy is
// network_mode: host, so its traffic is the host's and passes.
//
// Bound to each sender's bridge gateway IP, not 0.0.0.0 — the subnets are fixed
// (docs/REFERENCE.md § Docker subnets) so the gateway IP no longer moves.
otelcol.receiver.otlp "litellm" {
  grpc { endpoint = "10.89.0.1:4317" }
  http { endpoint = "10.89.0.1:4318" }
  output {
    traces = [otelcol.processor.filter.noise.input]
  }
}

otelcol.receiver.otlp "n8n" {
  grpc { endpoint = "10.89.1.1:4317" }
  http { endpoint = "10.89.1.1:4318" }
  output {
    traces = [otelcol.processor.filter.noise.input]
  }
}

otelcol.receiver.otlp "open_webui" {
  grpc { endpoint = "10.89.2.1:4317" }
  http { endpoint = "10.89.2.1:4318" }
  output {
    traces = [otelcol.processor.filter.noise.input]
  }
}

// Drop traffic that is never worth a trace. Only self-contained requests are listed —
// dropping a span with children would orphan them, so nothing here is a parent.
//
// The healthchecks alone are the bulk of it: LiteLLM's compose healthcheck curls
// /health/liveliness every 60s, forever, and each one is a full trace.
//
// Read off a real trace: fastapi instrumentation sets `http.target`, not `url.path` —
// the `_app` rule below never matched anything until this fix. `/_app/version.json` is
// the browser's periodic version poll.
otelcol.processor.filter "noise" {
  error_mode = "ignore"
  traces {
    span = [
      `IsMatch(attributes["http.route"], "^/health(/.*)?$")`,
      `IsMatch(attributes["url.path"], "^/health(/.*)?$")`,
      `IsMatch(attributes["http.target"], "^/(static|_app)/")`,
      // The Postgres cutover (sidekick-stack step 5) made this dead code — db.system is
      // "postgresql" now, and the pool's per-request connect span became the dominant
      // noise source, unfiltered the whole time. Leaf span, dropping it orphans nothing.
      `name == "connect" and attributes["db.system"] == "postgresql"`,
    ]
  }
  output { traces = [otelcol.processor.batch.traces.input] }
}

otelcol.processor.batch "traces" {
  output { traces = [otelcol.exporter.otlp.tempo.input] }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "100.64.0.1:4317"
    tls { insecure = true }   // mesh-only, WireGuard already encrypts it
  }
}

// ---- docker logs ----
discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}
discovery.relabel "logs" {
  targets = discovery.docker.local.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}
loki.source.docker "logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.logs.output
  forward_to = [loki.write.central.receiver]
}
