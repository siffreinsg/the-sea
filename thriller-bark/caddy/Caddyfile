{
	email hello@siffreinsigy.me
	acme_dns cloudflare {env.CF_API_TOKEN}
	metrics
	admin off
}

# Metrics only. Loopback, plaintext, no ACME. Exists so `admin off` above can be set
# without blinding Alloy — the admin endpoint on :2019 was unauthenticated read/write
# config for any local user.
http://127.0.0.1:2020 {
	metrics /metrics
}

*.siffreinsigy.me {
	# The only record that a public request happened. Alloy already ships this
	# container's stdout to Loki (container="caddy"), 30-day retention.
	log {
		output stdout
		format json
	}
	# No `preload` until includeSubDomains is verified safe for every name
	# under the apex — preload is effectively irreversible.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	@up host up.siffreinsigy.me
	handle @up {
		respond "the sea is up" 200
	}

	@headscale host headscale.siffreinsigy.me
	handle @headscale {
		reverse_proxy 127.0.0.1:8080
	}

	@komodo host komodo.siffreinsigy.me
	handle @komodo {
		reverse_proxy 127.0.0.1:9120
	}

	@auth host auth.siffreinsigy.me
	handle @auth {
		reverse_proxy 127.0.0.1:9091
	}

	@dawarich host dawarich.siffreinsigy.me
	handle @dawarich {
		reverse_proxy 100.64.0.1:3200
	}

	@backrest-tb host backrest-tb.siffreinsigy.me
	handle @backrest-tb {
		reverse_proxy 127.0.0.1:9898
	}

	@backrest-gm host backrest-gm.siffreinsigy.me
	handle @backrest-gm {
		reverse_proxy 100.64.0.1:9898
	}

	@grafana host grafana.siffreinsigy.me
	handle @grafana {
		reverse_proxy 100.64.0.1:3000
	}

	@actualbudget host actual.siffreinsigy.me
	handle @actualbudget {
		reverse_proxy 127.0.0.1:5006
	}

	@profilarr host profilarr.siffreinsigy.me
	handle @profilarr {
		reverse_proxy 100.64.0.1:6868
	}

	@cleanuparr host cleanuparr.siffreinsigy.me
	handle @cleanuparr {
		reverse_proxy 100.64.0.1:11011
	}

	@n8n host n8n.siffreinsigy.me
	handle @n8n {
		reverse_proxy 127.0.0.1:5678
	}

	# LiteLLM has its own Authelia OIDC client, so no forward_auth — that was one login
	# too many, since the admin UI has a mandatory login of its own that cannot be
	# disabled. SSO is free below five users at v1.93.0 (ui_sso.py:858).
	# The trade this makes: LiteLLM's API surface is now publicly reachable, protected by
	# its own bearer keys rather than by the edge. That is the same posture as komodo and
	# grafana, and the master key is a 43-char random. Blocking /v1/* here is possible but
	# not free — the UI calls root-level endpoints and would need an allowlist that breaks
	# on upgrade.
	@litellm host ai.siffreinsigy.me
	handle @litellm {
		# /metrics is unauthenticated on the proxy (see litellm/config.yaml) so Alloy can
		# scrape it without a virtual key in a plaintext config. It must never be public:
		# it carries spend, virtual-key aliases and the model list. Order matters — this
		# has to precede reverse_proxy or the proxy answers first.
		@metrics path /metrics /metrics/*
		respond @metrics 404
		reverse_proxy 127.0.0.1:4000
	}

	# Open-WebUI has its own OIDC client in Authelia, so no forward_auth here.
	@open-webui host chat.siffreinsigy.me
	handle @open-webui {
		reverse_proxy 127.0.0.1:3020
	}

	@your_spotify host spotify.siffreinsigy.me
	handle @your_spotify {
		@your_spotify_api path /api/*
		handle @your_spotify_api {
			reverse_proxy 100.64.0.1:8095
		}
		handle {
			forward_auth 127.0.0.1:9091 {
				uri /api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}
			reverse_proxy 100.64.0.1:8095
		}
	}

	handle {
		abort
	}
}

overseerr.blackpearl.siffreinsigy.me {
	redir https://seerr-thousandsunny.fox.usbx.me{uri} 302
}

# --- mesh relay ---------------------------------------------------------------------
# Not a public site. Bridged containers on TB cannot dial 100.64.0.1 — the mesh guard
# DROPs 172.16.0.0/12 -> 100.64.0.0/10 in raw/PREROUTING — so a GM service with no auth
# of its own is reached through Caddy, which is network_mode: host and whose traffic is
# therefore the host's:
# docs/ADR/2026-07-29-caddy-relays-mesh-services-to-containers.md
#
# Binds 0.0.0.0 because senders sit on two different bridges and gateway IPs move when a
# network is recreated. That is the third exception to the bind rule; the perimeter
# firewall (80/443/22 inbound, nothing else) plus the tailnet ACL are the gate — this also
# listens on tailscale0. Callers use host.docker.internal, never a literal 172.x.
:8090 {
	# This one logs the query string, unlike the public site's own log and unlike
	# Open-WebUI's audit path, which excludes chat bodies on purpose. Deliberate: single
	# user, own searches, and it is the only view of what the model actually asked for.
	log {
		output stdout
		format json
	}
	reverse_proxy 100.64.0.1:8080
}

:8091 {
	reverse_proxy 100.64.0.1:3002
}
