# Keeps bridged containers off the tailnet.
#
# Docker's per-bridge MASQUERADE plus Tailscale's ts-forward accept means every
# container on a TB bridge network can reach 100.64.0.0/10 — GM's unauthenticated
# VictoriaMetrics and Loki included — even though no container is a tailnet member.
# A Headscale ACL can't fix this: the masquerade rewrites the source to TB's own
# tailnet IP, so GM cannot tell container traffic from host traffic. The drop has
# to happen here, before the NAT.
#
# It lives in raw/PREROUTING, not DOCKER-USER, and that is the whole point.
# `FORWARD` on this node reads:
#     -A FORWARD -j ts-forward        <-- accepts mesh-bound traffic here
#     -A FORWARD -j DOCKER-USER       <-- never reached for those packets
# Docker and Tailscale both insert their jump at position 1, so whoever restarted
# last wins and the order is not something to rely on. raw/PREROUTING is the first
# netfilter hook a packet meets, before either chain and before conntrack, so
# neither daemon can jump the queue. DROP, not REJECT — REJECT only exists in
# filter. Docker already keeps its own rules in this table, so it is a normal
# place for this to live.
#
# Docker flushes its chains when it starts, so PartOf= re-runs this on every
# docker restart. Caddy and Komodo Core are network_mode: host and unaffected.
#
# Install (once, mirrors thriller-bark/backups/README.md):
#   sudo ln -sf /opt/the-sea/thriller-bark/firewall/the-sea-mesh-guard.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now the-sea-mesh-guard

[Unit]
Description=Block bridged containers from reaching the tailnet
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t raw -C PREROUTING -s 172.16.0.0/12 -d 100.64.0.0/10 -j DROP 2>/dev/null || iptables -t raw -I PREROUTING -s 172.16.0.0/12 -d 100.64.0.0/10 -j DROP'
ExecStartPost=/bin/sh -c 'iptables -D DOCKER-USER -s 172.16.0.0/12 -d 100.64.0.0/10 -j REJECT 2>/dev/null; true'

[Install]
WantedBy=multi-user.target
