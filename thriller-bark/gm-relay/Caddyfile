{
	admin off
}

# 0.0.0.0, not 127.0.0.1: gm-relay is network_mode: host, so a loopback-only bind is
# unreachable from bridge containers (they see the host through their bridge gateway,
# never the host's own 127.0.0.1). Callers use host.docker.internal, never a literal
# gateway IP — the perimeter firewall (80/443/22 inbound, nothing else) plus the mesh
# guard are the compensating control, same reasoning as Alloy's OTLP receiver.

# gm-relay itself only ever speaks plain HTTP (no TLS between the public Caddy and here),
# so reverse_proxy's default X-Forwarded-Proto would say "http" and clobber what the
# public Caddy already set — breaking any backend that redirects on it (Dawarich looped
# forever on this). Every caller reaches gm-relay only via the public Caddy's https
# frontend, so pin it. header_up is a reverse_proxy subdirective, so the snippet has to
# be imported inside the reverse_proxy block, not the site block.
(forwarded-https) {
	header_up X-Forwarded-Proto https
}

:13200 {
	reverse_proxy 100.64.0.1:3200 {
		import forwarded-https
	}
}

