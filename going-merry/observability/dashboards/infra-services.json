{
  "uid": "infra-services",
  "title": "Infra services",
  "tags": ["infra"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "type": "row", "title": "Caddy", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "type": "timeseries",
      "title": "Requests per second by status class",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(caddy_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Response latency, p50 / p95",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(caddy_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(caddy_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Reverse-proxy upstreams healthy",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "targets": [{ "refId": "A", "expr": "min(caddy_reverse_proxy_upstreams_healthy)", "instant": true }]
    },
    {
      "type": "stat",
      "title": "Errors per second",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(rate(caddy_http_request_errors_total[$__rate_interval]))" }]
    },
    { "type": "row", "title": "Headscale", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 } },
    {
      "type": "stat",
      "title": "Registered nodes",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 14 },
      "targets": [{ "refId": "A", "expr": "headscale_nodestore_nodes", "instant": true }]
    },
    {
      "type": "timeseries",
      "title": "Map response cycle, rate",
      "description": "How often Headscale is pushing peer-list updates. Spikes track node churn (reconnects, new nodes), not traffic through the mesh.",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 14 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(headscale_mapresponse_sent_total[$__rate_interval])", "legendFormat": "sent" },
        { "refId": "B", "expr": "rate(headscale_mapresponse_ended_total[$__rate_interval])", "legendFormat": "ended" }
      ]
    },
    { "type": "row", "title": "Bot mitigation", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 } },
    {
      "type": "timeseries",
      "title": "Caddy rate-limit rejections, TB",
      "description": "caddy-ratelimit exports no metric of its own (checked against a live /metrics, 2026-08-02) — this counts 429s from the standard caddy_http_requests_total series instead, same job as the panels above.",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(caddy_http_requests_total{code=\"429\"}[$__rate_interval]))",
          "legendFormat": "429s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "fail2ban bans, both nodes",
      "description": "Tailed from /var/log/fail2ban.log (thriller-bark/alloy and going-merry/alloy config.alloy) — fail2ban isn't a container, so it's not in the docker-discovery log path.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (count_over_time({job=\"fail2ban\"} |= \"Ban\" [$__interval]))",
          "legendFormat": "{{node}}"
        }
      ]
    }
  ]
}
