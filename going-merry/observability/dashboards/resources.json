{
  "uid": "the-sea-resources",
  "title": "Resources — who is eating the box",
  "tags": ["infra"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
        "query": "label_values(container_memory_working_set_bytes, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Disk — the one that takes the box down", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    {
      "type": "bargauge",
      "title": "Root filesystem used",
      "description": "The alert fires below 10% free. Everything below this row explains where the space went.",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 7, "w": 7, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 0.8 },
            { "color": "red", "value": 0.9 }
          ] }
        },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (node_filesystem_avail_bytes{mountpoint=\"/\", node=~\"$node\"} / node_filesystem_size_bytes{mountpoint=\"/\", node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Docker volumes by size",
      "description": "THE disk culprit panel. cadvisor cannot see this — it only measures a container's writable layer, while every byte that matters (Postgres, Loki, VictoriaMetrics, Tempo, chat history) lives in a named volume. Fed by the hourly the-sea-volume-sizes timer, so it updates on the hour, not live.",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 7, "w": 10, "x": 7, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, docker_volume_size_bytes{node=~\"$node\"})",
          "legendFormat": "{{node}} — {{volume}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Volume growth",
      "description": "Slope matters more than height: a volume growing steadily will exhaust the disk on a predictable date, a big-but-flat one never will.",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 7, "w": 7, "x": 17, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, docker_volume_size_bytes{node=~\"$node\"})",
          "legendFormat": "{{volume}}"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Container writable layer",
      "description": "Data a container wrote OUTSIDE any volume — logs, temp files, anything mistakenly not persisted. Small numbers are healthy; a large one usually means something is writing where it should not. Not reported for every container.",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (name, node) (container_fs_usage_bytes{name!=\"\", node=~\"$node\"}))",
          "legendFormat": "{{node}} — {{name}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Root filesystem free",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\", node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },

    { "type": "row", "title": "Memory", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 } },

    {
      "type": "bargauge",
      "title": "Memory by container, now",
      "description": "Working set, which is what the OOM killer actually looks at — not container_memory_usage_bytes, which counts reclaimable page cache and makes idle containers look fat.",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, sum by (name, node) (container_memory_working_set_bytes{name!=\"\", node=~\"$node\"}))",
          "legendFormat": "{{node}} — {{name}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory over time",
      "description": "A container that only ever climbs is leaking. That is what this panel is for.",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (name) (container_memory_working_set_bytes{name!=\"\", node=~\"$node\"}))",
          "legendFormat": "{{name}}"
        }
      ]
    },

    { "type": "row", "title": "CPU", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 } },

    {
      "type": "bargauge",
      "title": "CPU by container, now",
      "description": "Cores, not percent: 1.0 means one core fully busy. GM is single-threaded, so anything approaching 1.0 there is saturation.",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3 }, "overrides": [] },
      "options": { "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, sum by (name, node) (rate(container_cpu_usage_seconds_total{name!=\"\", node=~\"$node\"}[5m])))",
          "legendFormat": "{{node}} — {{name}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU over time",
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\", node=~\"$node\"}[5m])))",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}
